APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-api-domain.example

# Kavenegar: create an approved OTP template named parsai first.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=parsai

# OpenAI API credentials are server-only. Never put this key in App.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SEARCH_MODEL=gpt-5.5
RECOMMENDATION_CACHE_SECONDS=43200

# Local SQLite is used by default. For deployment, mount persistent storage.
DATABASE_PATH=./parsai.db
